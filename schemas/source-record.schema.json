{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-rag.local/schemas/source-record.schema.json",
  "title": "Engineering RAG source record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "source_id",
    "source_name",
    "provenance_class",
    "authority_level",
    "upstream_project",
    "upstream_url",
    "upstream_remote",
    "branch",
    "commit",
    "tag",
    "acquisition_date",
    "license",
    "local_snapshot_path",
    "file_count",
    "byte_count",
    "inventory_hash",
    "source_status",
    "inclusion_status",
    "expected_document_types",
    "proposed_parser",
    "proposed_chunking_profile",
    "notes"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
    "source_name": {"type": "string", "minLength": 1},
    "provenance_class": {"enum": ["official_docs", "community_docs", "internal_work"]},
    "authority_level": {"type": "string", "minLength": 1},
    "upstream_project": {"type": "string", "minLength": 1},
    "upstream_url": {"type": "string", "minLength": 1},
    "upstream_remote": {"type": "string", "minLength": 1},
    "branch": {"type": ["string", "null"]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tag": {"type": ["string", "null"]},
    "acquisition_date": {"type": "string", "format": "date-time"},
    "license": {"type": "object"},
    "local_snapshot_path": {"type": "string", "pattern": "^/"},
    "file_count": {"type": "integer", "minimum": 0},
    "byte_count": {"type": "integer", "minimum": 0},
    "inventory_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_status": {"type": "string"},
    "inclusion_status": {"type": "string"},
    "expected_document_types": {"type": "array", "items": {"type": "string"}},
    "proposed_parser": {"type": "string"},
    "proposed_chunking_profile": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
